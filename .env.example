# Copy to `.env` and fill in. `.env` is gitignored; this file is the source of truth for what the
# app reads. The schema that validates these lives in src/env.js.

# --- Auth.js -------------------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public URL of the auth routes. Use 127.0.0.1 locally: Spotify no longer accepts "localhost"
# redirect URIs, and cookies are per host, so the whole app has to be opened on 127.0.0.1 too.
#   local: http://127.0.0.1:3000/crossfade/api/auth
#   prod:  https://sleeep.dev/crossfade/api/auth
AUTH_URL="http://127.0.0.1:3000/crossfade/api/auth"
# Origin people reach the app at; used to build share links.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# --- Spotify ---------------------------------------------------------------------------------------
# https://developer.spotify.com/dashboard -> Create app (Web API + Web Playback SDK)
# Redirect URI: <AUTH_URL>/callback/spotify
# Also used without a user (client credentials) for search, so guests get Spotify results.
AUTH_SPOTIFY_ID=""
AUTH_SPOTIFY_SECRET=""

# --- Google / YouTube ------------------------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# Redirect URI: <AUTH_URL>/callback/google
# Enable "YouTube Data API v3" on the same project for library import.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# API key for YouTube search and video lookups (10,000 quota units/day; a search costs 100).
YOUTUBE_API_KEY=""

# --- Local development ---------------------------------------------------------------------------
# Adds a username-only login on /signin so you can test playlists and sharing without OAuth apps.
# Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN="false"

# --- Database --------------------------------------------------------------------------------------
# docker compose up -d   starts this database locally.
DATABASE_URL="mysql://root:crossfade@127.0.0.1:3306/crossfade"
